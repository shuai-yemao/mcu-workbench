{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcu-workbench/plugin-descriptor/1.0.0",
  "type": "object",
  "required": ["id", "version", "capabilities", "dependencies", "lifecycle"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string" },
    "capabilities": { "type": "array", "items": { "$ref": "capability.schema.json" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "lifecycle": { "type": "object", "required": ["load", "dispose"] }
  },
  "additionalProperties": false
}
